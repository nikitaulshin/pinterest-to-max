# Каталог SQLite, изображений, приватных профилей браузера и диагностики.
# Относительный путь считается от рабочего каталога процесса.
DATA_DIR=./data

# Одна доска Pinterest; HTTPS-адрес без параметров и данных входа.
PINTEREST_BOARD_URL=https://ru.pinterest.com/mixi56453/max7

# По умолчанию Playwright Chromium: npm run browser:install.
# chrome — только явный выбор уже установленного Google Chrome, без fallback.
PINTEREST_BROWSER_CHANNEL=chromium
# Явный канал MAX без параметров; обязателен только для auth max.
# Укажите существующий канал, которым вы управляете; значения по умолчанию нет.
MAX_CHANNEL_URL=
MAX_BROWSER_CHANNEL=chromium
