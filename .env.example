# Каталог SQLite, изображений, приватных профилей браузера и диагностики.
# Относительный путь считается от рабочего каталога процесса.
# Compose использует том /app/data; этот путь относится к хосту.
# Существующий каталог не переносится в том автоматически.
DATA_DIR=./data

# Одна доска Pinterest; HTTPS-адрес без параметров и данных входа.
PINTEREST_BOARD_URL=https://ru.pinterest.com/mixi56453/max7

# По умолчанию Playwright Chromium: npm run browser:install.
# chrome — только явный выбор уже установленного Google Chrome, без fallback.
# Compose явно задаёт chromium для обоих браузеров независимо от выбора на хосте.
PINTEREST_BROWSER_CHANNEL=chromium
# Интервал независимых циклов run; по умолчанию 300 секунд.
# Допустимо 0.001..2147483.647; сетевые повторы не чаще интервала и минимум 5 секунд.
SYNC_INTERVAL_SECONDS=300

# Явный канал MAX без параметров; обязателен для auth max, plan --dry-run и run.
# Укажите существующий канал, которым вы управляете; значения по умолчанию нет.
MAX_CHANNEL_URL=
MAX_BROWSER_CHANNEL=chromium

# Для plan --dry-run и run: уникальные ежедневные времена HH:mm по Москве, без пробелов.
# Укажите своё расписание; значения по умолчанию нет.
PUBLICATION_SLOTS=
# Горизонт: положительное целое число календарных дней, по умолчанию 14.
# До того же московского времени включительно; начало строго в будущем.
PLANNING_HORIZON_DAYS=14
# Для plan --dry-run и run: положительный целый лимит отложки, по умолчанию не задан.
# Эффективный предел — минимум настройки и 100 (документированный предел MAX).
# Все посты, включая ручные вне горизонта, расходуют ёмкость;
# незавершённые назначения учитываются дополнительно до положительной сверки.
MAX_SCHEDULED_LIMIT=
